"rgba(255,127,14,1)\"},\"xaxis\":\"x\",\"frame\":null}],\"highlight\":{\"on\":\"plotly_click\",\"persistent\":false,\"dynamic\":false,\"selectize\":false,\"opacityDim\":0.20000000000000001,\"selected\":{\"opacity\":1},\"debounce\":0},\"shinyEvents\":[\"plotly_hover\",\"plotly_click\",\"plotly_selected\",\"plotly_relayout\",\"plotly_brushed\",\"plotly_brushing\",\"plotly_clickannotation\",\"plotly_doubleclick\",\"plotly_deselect\",\"plotly_afterplot\",\"plotly_sunburstclick\"],\"base_url\":\"https://plot.ly\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n\n\n**Note:** Each unique `procedure_occurrence_id` represents a distinct genomic test order. A single test may detect multiple variants in a patient.\n:::\n\n## Variant Characteristics {.tabset}\n\n::: {.panel-tabset}\n\n### Top Genes\n\nThe following visualization shows the most frequently mutated genes in the cohort.\n\n\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"plotly html-widget html-fill-item\" id=\"htmlwidget-e339047ac4f9c70a0f68\" style=\"width:100%;height:464px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-e339047ac4f9c70a0f68\">{\"x\":{\"visdat\":{\"82b75e2e3e51\":[\"function () \",\"plotlyVisDat\"]},\"cur_data\":\"82b75e2e3e51\",\"attrs\":{\"82b75e2e3e51\":{\"y\":{},\"x\":{},\"marker\":{\"color\":\"#8dd3c7\"},\"text\":{},\"textposition\":\"outside\",\"hovertemplate\":\"<b>%{y}<\\/b><br> Variants: %{x:,.0f}<br> Patients: %{customdata:,.0f}<br> <extra><\\/extra>\",\"customdata\":{},\"alpha_stroke\":1,\"sizes\":[10,100],\"spans\":[1,20],\"type\":\"bar\"}},\"layout\":{\"margin\":{\"b\":40,\"l\":100,\"t\":25,\"r\":10},\"xaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"Number of Variants\"},\"yaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"\",\"type\":\"category\",\"categoryorder\":\"array\",\"categoryarray\":[\"ATR\",\"NOTCH3\",\"TET2\",\"POLE\",\"CREBBP\",\"PIK3CA\",\"PTEN\",\"SETD2\",\"ROS1\",\"NOTCH1\",\"DNMT3A\",\"NF1\",\"