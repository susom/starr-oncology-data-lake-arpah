splay}\n\n```{=html}\n<div class=\"plotly html-widget html-fill-item\" id=\"htmlwidget-31f60952cfe68c8ebd66\" style=\"width:100%;height:464px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-31f60952cfe68c8ebd66\">{\"x\":{\"visdat\":{\"82b738815c03\":[\"function () \",\"plotlyVisDat\"]},\"cur_data\":\"82b738815c03\",\"attrs\":{\"82b738815c03\":{\"y\":{},\"x\":{},\"marker\":{\"color\":\"#bebada\"},\"customdata\":{},\"hovertemplate\":\"<b>%{y}<\\/b><br> Variants: %{x:,.0f}<br> Patients: %{customdata:,.0f}<br> <extra><\\/extra>\",\"alpha_stroke\":1,\"sizes\":[10,100],\"spans\":[1,20],\"type\":\"bar\"}},\"layout\":{\"margin\":{\"b\":40,\"l\":150,\"t\":25,\"r\":10},\"xaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"Number of Variants\"},\"yaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"\",\"type\":\"category\",\"categoryorder\":\"array\",\"categoryarray\":[\"Nonsense\",\"Frameshift Variant\",\"Missense Variant\"]},\"title\":\"\",\"hovermode\":\"closest\",\"showlegend\":false},\"source\":\"A\",\"config\":{\"modeBarButtonsToAdd\":[\"hoverclosest\",\"hovercompare\"],\"showSendToCloud\":false},\"data\":[{\"y\":[\"Missense Variant\",\"Frameshift Variant\",\"Nonsense\"],\"x\":[7684,811,730],\"marker\":{\"color\":\"#bebada\",\"line\":{\"color\":\"rgba(31,119,180,1)\"}},\"customdata\":[1366,490,455],\"hovertemplate\":[\"<b>%{y}<\\/b><br> Variants: %{x:,.0f}<br> Patients: %{customdata:,.0f}<br> <extra><\\/extra>\",\"<b>%{y}<\\/b><br> Variants: %{x:,.0f}<br> Patients: %{customdata:,.0f}<br> <extra><\\/extra>\",\"<b>%{y}<\\/b><br> Variants: %{x:,.0f}<br> Patients: %{customdata:,.0f}<br> <extra><\\/extra>\"],\"type\":\"bar\",\"orientation\":\"h\",\"error_y\":{\"color\":\"rgba(31,119,180,1)\"},\"error_x\":{\"color\":\"rgba(31,119,180,1)\"},\"xaxis\":\"x\",\"yaxis\":\"y\",\"frame\":null}],\"highlight\":{\"on\":\"plotly_click\",\"persistent\":false,\"dynamic\":false,\"selectize\":false,\"opacityDim\":0.20000000000000001,\"selected\":{\"opacity\":1},\"debounce\":0},\"shinyEvents\":[\"plotly_hover\",\"plotly_click\",\"plotly_selected\",\"plotly_relayout\",\"plotly_brushed\",\"plotly_brushing\",\"plotly_clickannotation\",\"plotly_doubleclick\",\"plotly_deselect\",\"plotly_afterplot\",\"plotly_sunburstclick\"],\"base_url\":\"https://plot.ly\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\n\n\n**Key Consequence Types:**\n\n- **Missense:** Amino acid change\n- **Nonsense:** Premature stop codon\n- **Frameshift:** Reading frame disruption\n- **Splice site:** Affects RNA splicing\n\n### Clinical Classification\n\nDistribution of variants by phenotype-specific variant classification.\n\n\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"plotly html-widget html-fill-item\" id=\"htmlwidget-44cbac53eeba15bcad59\" style=\"width:100%;height:464px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-44cbac53eeba15bcad59\">{\"x\":{\"visdat\":{\"82b7519e92c0\":[\"function () \",\"plotlyVisDat\"]},\"cur_data\":\"82b7519e92c0\",\"attrs\":{\"82b7519e92c0\":{\"y\":{},\"x\":{},\"marker\":{\"color\":\"#b3de69\"},\"customdata\":{},\"hovertemplate\":\"<b>%{y}<\\/b><br> Variants: %{x:,.0f}<br> Patients: %{customdata:,.0f}<br> <extra><\\/extra>\",\"alpha_stroke\":1,\"sizes\":[10,100],\"spans\":[1,20],\"type\":\"bar\"}},\"layout\":{\"margin\":{\"b\":40,\"l\":200,\"t\":25,\"r\":10},\"xaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"Number of Variants\"},\"yaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"\",\"type\":\"category\",\"categoryorder\":\"array\",\"categoryarray\":[\"Likely pathogenic\",\"Pathogenic\",\"Uncertain significance\"]},\"title\":\"\",\"hovermode\":\"closest\",\"showlegend\":false},\"source\":\"A\",\"config\":{\"modeBarButtonsToAdd\":[\"hoverclosest\",\"hovercompare\"],\"showSendToCloud\":false},\"data\":[{\"y\":[\"Uncertain significance\",\"Pathogenic\",\"Likely pathogenic\"],\"x\":[6860,2645,842],\"marker\":{\"color\":\"#b3de69\",\"line\":{\"color\":