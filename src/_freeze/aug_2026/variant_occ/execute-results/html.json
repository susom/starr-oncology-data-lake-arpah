n\n\n::: {.panel-tabset}\n\n### Gene Mutations\n\nTop genes mutated in thoracic tumor board patients.\n\n\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"plotly html-widget html-fill-item\" id=\"htmlwidget-a69e379fa06afdf08d4e\" style=\"width:100%;height:464px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-a69e379fa06afdf08d4e\">{\"x\":{\"visdat\":{\"894377779088\":[\"function () \",\"plotlyVisDat\"]},\"cur_data\":\"894377779088\",\"attrs\":{\"894377779088\":{\"x\":{},\"y\":{},\"z\":{},\"colorscale\":[[\"0\",\"#f3f0f7\"],[\"0.5\",\"#bebada\"],[\"1\",\"#6a4c93\"]],\"hovertemplate\":\"<b>%{y}<\\/b><br> %{x}: %{z}<br> <extra><\\/extra>\",\"showscale\":true,\"colorbar\":{\"title\":\"Count\"},\"alpha_stroke\":1,\"sizes\":[10,100],\"spans\":[1,20],\"type\":\"heatmap\"}},\"layout\":{\"margin\":{\"b\":80,\"l\":100,\"t\":25,\"r\":100},\"xaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"\",\"side\":\"bottom\"},\"yaxis\":{\"domain\":[0,1],\"automargin\":true,\"title\":\"\"},\"scene\":{\"zaxis\":{\"title\":\"cbind(n_variants, n_patients)\"}},\"hovermode\":\"closest\",\"showlegend\":false,\"legend\":{\"yanchor\":\"top\",\"y\":0.5}},\"source\":\"A\",\"config\":{\"modeBarButtonsToAdd\":[\"hoverclosest\",\"hovercompare\"],\"showSendToCloud\":false},\"data\":[{\"colorbar\":{\"title\":\"Count\",\"ticklen\":2,\"len\":0.5,\"lenmode\":\"fraction\",\"y\":1,\"yanchor\":\"top\"},\"colorscale\":[[\"0\",\"#f3f0f7\"],[\"0.5\",\"#bebada\"],[\"1\",\"#6a4c93\"]],\"showscale\":true,\"x\":[\"Variant Count\",\"Patient Count\"],\"y\":[\"TP53\",\"EGFR\",\"LRP1B\",\"DNMT3A\",\"KRAS\",\"ATM\",\"ROS1\",\"APC\",\"BRCA2\",\"MET\",\"ARID1A\",\"PIK3CA\",\"NOTCH1\",\"TERT\",\"POLE\"],\"z\":[[177,123],[121,79],[78,54],[65,32],[60,46],[52,39],[44,34],[36,26],[33,27],[32,27],[30,27],[29,24],[27,23],[24,21],[24,21]],\"hovertemplate\":\"<b>%{y}<\\/b><br> %{x}: %{z}<br> <extra><\\/extra>\",\"type\":\"heatmap\",\"xaxis\":\"x\",\"yaxis\":\"y\",\"frame\":null}],\"h